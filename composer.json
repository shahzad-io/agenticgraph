{
    "name": "agenticgraph/agenticgraph",
    "description": "AgenticGraph is a Laravel package that provides LangGraph-inspired agentic workflow orchestration with native Laravel patterns, integrated with PrismPHP for AI capabilities. It enables developers to build complex, stateful AI agents and multi-step workflows using a graph-based architecture.",
    "keywords": [
        "shahzad",
        "laravel",
        "agenticgraph",
        "ai",
        "llm",
        "agents",
        "workflow",
        "graph",
        "orchestration",
        "prism"
    ],
    "homepage": "https://github.com/shahzad-io/agenticgraph",
    "support": {
        "issues": "https://github.com/shahzad-io/agenticgraph/issues",
        "source": "https://github.com/shahzad-io/agenticgraph",
        "docs": "https://agenticgraph.dev/docs/overview"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "shahzad",
            "email": "shahzadsarwar.work@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.61.1 || ^13.12.0",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.61.1 || ^13.12.0",
        "prism-php/prism": "^0.102.0",
        "prism-php/relay": "^1.8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9.3",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.9.2",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.43.6"
    },
    "autoload": {
        "psr-4": {
            "Shahzad\\AgenticGraph\\": "src/",
            "Shahzad\\AgenticGraph\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shahzad\\AgenticGraph\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "test:ide": "vendor/bin/pest tests/IDESupport --no-coverage",
        "stan:ide": "vendor/bin/phpstan analyse --configuration=phpstan-ide.neon",
        "check:ide": [
            "@test:ide",
            "@stan:ide"
        ]
    },
    "scripts-descriptions": {
        "test:ide": "Run IDE support validation tests",
        "stan:ide": "Run strict PHPStan analysis on IDE-critical files",
        "check:ide": "Run all IDE support checks (tests + static analysis)"
    },
    "suggest": {
        "barryvdh/laravel-ide-helper": "For enhanced IDE autocomplete support (recommended for development)"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shahzad\\AgenticGraph\\AgenticGraphServiceProvider"
            ],
            "aliases": {
                "AgenticGraph": "Shahzad\\AgenticGraph\\Facades\\AgenticGraph",
                "Trace": "Shahzad\\AgenticGraph\\Facades\\Trace"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
